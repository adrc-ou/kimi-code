# ------------------------------------------------------------
# Workspace
# ------------------------------------------------------------

# Host path to the actual project Kimi is allowed to modify.
WORKSPACE_PATH=../workspace


# ------------------------------------------------------------
# OU / NRP LiteLLM
# ------------------------------------------------------------

# This secret is passed ONLY to the model-proxy container.
LITELLM_API_KEY=

# Origin only; do not include /v1 here.
LITELLM_UPSTREAM_ORIGIN=https://ellm.nrp-nautilus.io

# The identifier exposed by OU LiteLLM.
# Currently mislabeled there; it resolves to Qwen3.8-Flash-Next.
LITELLM_MODEL_ID=Qwen3.5 397B

# Preserve your existing NRP concurrency policy.
SAFE_CONTEXT=320000


# ------------------------------------------------------------
# Qwen / Kimi behavior
# ------------------------------------------------------------

KIMI_MODEL_CAPABILITIES=thinking,tool_use
KIMI_MODEL_THINKING_EFFORT=xhigh


# ------------------------------------------------------------
# NRP qwen3 fair-use policy
# ------------------------------------------------------------

# NRP currently serves qwen3 with a 1M context window.
NRP_MODEL_CONTEXT=1000000

# Current NRP Fair Use Policy threshold.
NRP_FAIR_USE_PERCENT=35

# Deliberately stay below the 350K hard fair-use threshold.
NRP_PARALLEL_CONTEXT_BUDGET=320000

# Current NRP maximum concurrency for short qwen3 requests.
NRP_MODEL_MAX_CONCURRENCY=16

# Our own stricter concurrency limit.
KIMI_SUBAGENT_CONCURRENCY=5

# 320000 / 5
KIMI_SUBAGENT_CONTEXT=64000

# Leave room inside each 64K subagent window for generation/tool calls.
KIMI_SUBAGENT_INPUT=55808

# Default primary-agent window.
# This deliberately stays near Qwen's native 262K context.
KIMI_PRIMARY_CONTEXT=262144

# Optional explicit long-context primary alias.
KIMI_LONG_CONTEXT=1000000

# Kimi fallback reserve.
KIMI_CONTEXT_RESERVE=8192


# ------------------------------------------------------------
# Optional GitHub MCP
# ------------------------------------------------------------

# Use a dedicated, minimal, read-only token.
# Leave blank until GitHub MCP is enabled.
GITHUB_PERSONAL_ACCESS_TOKEN=


# ------------------------------------------------------------
# Optional live ComfyUI connection
# ------------------------------------------------------------

# For the opt-in host bridge described below:
# COMFYUI_URL=http://host.docker.internal:8188
COMFYUI_URL=
