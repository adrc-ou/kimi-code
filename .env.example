# ------------------------------------------------------------
# Workspace
# ------------------------------------------------------------

# Host path to the actual project Kimi is allowed to modify.
WORKSPACE_PATH=../workspace

# ------------------------------------------------------------
# Model provider credentials
# ------------------------------------------------------------

# Which model serves the primary agent and the subagents is NOT chosen here: ./start.sh
# asks for both, from the definitions in ./models and ./providers. Every context window,
# concurrency ceiling and rate limit follows from that choice. See docs/models-providers.md.

# Model API keys are set here, but no key variable is listed, deliberately: which names
# exist depends on the models and providers installed, and any one operator needs only
# some of them. Find the names for what you have:
#
#     grep -rn '^key_env = \|^env = ' models providers
#
# Each selected model then resolves its key from two scopes, most specific first:
#
#   model-scoped     the variable named by `key_env` in that model's models/<id>/model.toml.
#                    Set, and that model alone authenticates with it.
#   provider-scoped  the `env` of the [[credential]] the model names as `credential`, in
#                    providers/<id>/provider.toml. Used when the model's own variable is
#                    absent or blank, and shared by every model naming that credential.
#
# ./start.sh asks for whichever a selected model is missing, naming both variables, and a
# value you type there lasts for that session only. Either scope is passed ONLY to the
# model-proxy container: never to the agent, never to a tracked file.

# Optional. Blank means use the endpoint published by the selected provider's definition.
# Set it only to redirect that provider somewhere else (a different gateway host, for
# example); it overrides the definition, it is not where the normal value lives.
NRP_BASE_URL=


# ------------------------------------------------------------
# Kimi background capacity
# ------------------------------------------------------------

# Background task slots. Keep this above the subagent fan-out the launcher derives for
# your model pair so a backgrounded build does not cost a subagent a lane; the proxy,
# not this number, paces the provider. Blank leaves it at the derived value.
KIMI_BACKGROUND_TASK_SLOTS=

# Background Bash wall clock in seconds; 0 means no timeout. Subagent and swarm
# wall clocks are NOT set here: they live in runtime/config.toml as
# [subagent]/[swarm] timeout_ms, because the KIMI_*_TIMEOUT_MS variables accept
# only a positive integer and would outrank that file.
KIMI_BACKGROUND_BASH_TASK_TIMEOUT_S=0


# ------------------------------------------------------------
# Model proxy tunables
# ------------------------------------------------------------

# These bound the proxy process itself - memory, queue depth, and how long a stalled
# connection may hold a fair-use permit. No model window, provider percentage, or
# concurrency ceiling appears here: those come from the resolved plan.

# A stalled upstream read releases its permit instead of wedging the lane.
MODEL_PROXY_SOCK_READ_TIMEOUT=300

# Hard ceiling on how long the proxy keeps retrying one client request.
MODEL_PROXY_MAX_REQUEST_SECONDS=3600

# Coarse per-lane input ceiling (percent of the lane input cap) that catches policy
# drift or abuse without false-rejecting image and video payloads.
MODEL_PROXY_INPUT_GUARD_PERCENT=150
MODEL_PROXY_MEDIA_TOKEN_ESTIMATE=1600

# Ask for usage in streamed responses so output tokens are measured, not guessed.
# The proxy drops this automatically if the endpoint rejects stream_options.
MODEL_PROXY_REQUEST_USAGE=1

# Bounded proxy ingress. Increase only after reviewing host memory use.
MODEL_PROXY_MAX_REQUEST_BYTES=268435456
MODEL_PROXY_MAX_RESPONSE_BYTES=536870912
MODEL_PROXY_MAX_ERROR_BYTES=65536
MODEL_PROXY_MAX_QUEUED=32


# ------------------------------------------------------------
# Kimi session context
# ------------------------------------------------------------

# No variable in this file chooses the context the harness adds to a session. Every launch opens a
# context panel that lists the optional blocks one at a time - the usage limits, the per-model lane
# table, the parallelism guidance, module guidance, Skills, subagent roles - and asks which to
# include. All start enabled; whatever you change is remembered for the next launch.
#
# The prompt text those blocks are added to comes from SYSTEM.md and CONTEXT.md beside this file,
# and an absent file means Kimi's own text is used. See README, "Customising the session context".
#
# To change the selection without starting a session, or to see the one a script will get:
#   ./prompts.sh --configure
#   ./prompts.sh --show
# An unattended launch cannot prompt, so it applies the remembered selection and prints it.


# ------------------------------------------------------------
# Optional GitHub MCP
# ------------------------------------------------------------

# Use a dedicated, minimal, read-only token.
# Leave blank until GitHub MCP is enabled.
GITHUB_PERSONAL_ACCESS_TOKEN=


# ------------------------------------------------------------
# Optional release API authentication
# ------------------------------------------------------------

# Public GitHub release metadata works without a token, subject to the
# unauthenticated API rate limit. Use a dedicated read-only token only if needed.
GITHUB_RELEASES_TOKEN=

# Optional Context7 bearer credential. Context7 is enabled and works with no key at all, so
# this variable stays unused while runtime/mcp.json omits bearerTokenEnvVar from that entry.
# Adding the line activates the key and also makes Kimi require a non-empty value: an empty
# one then fails the server closed instead of falling back to anonymous access.
# Neither variable enables a disabled MCP server. See docs/verification.md.
CONTEXT7_API_KEY=


# ------------------------------------------------------------
# Local SearXNG
# ------------------------------------------------------------

# Generate with: openssl rand -hex 32
# Local SearXNG signing secret, not a third-party API token.
SEARXNG_SECRET=

# Bounded search normalization.
SEARCH_MAX_RESPONSE_BYTES=4194304
SEARCH_MAX_RESULTS=20
SEARCH_MAX_REQUEST_BYTES=65536
SEARCH_MAX_FIELD_CHARS=16384
SEARCH_MAX_OUTPUT_BYTES=1048576
SEARCH_CONNECT_TIMEOUT=10
SEARCH_READ_TIMEOUT=20

# Capacity warnings never block startup.
KIMI_WARN_FREE_DISK_GIB=20
KIMI_WARN_TOTAL_MEMORY_GIB=8
