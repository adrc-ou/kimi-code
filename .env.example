# ------------------------------------------------------------
# Workspace
# ------------------------------------------------------------

# Host path to the actual project Kimi is allowed to modify.
WORKSPACE_PATH=../workspace

# ------------------------------------------------------------
# OU / NRP LiteLLM
# ------------------------------------------------------------

# This secret is passed ONLY to the model-proxy container.
LITELLM_API_KEY=

# Origin only; do not include /v1 here.
LITELLM_UPSTREAM_ORIGIN=https://litellm.lib.ou.edu

# The identifier exposed by OU LiteLLM.
LITELLM_MODEL_ID="Qwen3.8 Flash Next"


# ------------------------------------------------------------
# NRP qwen3 fair-use policy
# ------------------------------------------------------------

# NRP serves qwen3 (Qwen3.8 Flash Next) with a 1,000,000-token advertised window.
# 262,144 of that is native; the rest needs YaRN scaling, which is why the default
# primary model stays at the native window and qwen3-long is opt-in.
NRP_MODEL_CONTEXT=1000000

# NRP fair use has three rules:
#   1. 200,000 output tokens per minute per API token (the only gateway-enforced
#      one; input tokens are not counted).
#   2. any single request using >=35% of context is limited to 1 concurrent request.
#   3. otherwise <=16 concurrent requests for qwen3, and all of them combined must
#      stay within 35% of the context window.
NRP_FAIR_USE_PERCENT=35

# Deliberately stay below the 350K aggregate threshold from rule 3. Raising this to
# 350000 lets one 64K subagent overlap the primary lane; the proxy derives lane
# exclusivity from these numbers instead of hard-coding it.
NRP_PARALLEL_CONTEXT_BUDGET=320000

# Rule 1, with headroom for output estimates that land slightly high.
NRP_OUTPUT_TOKENS_PER_MINUTE=200000
NRP_OUTPUT_RATE_HEADROOM_PERCENT=90

# Ask for usage in streamed responses so output tokens are measured, not guessed.
# The proxy drops this automatically if the gateway rejects stream_options.
NRP_REQUEST_USAGE=1

# Rule 3's request-count ceiling for qwen3; enforced on every admission.
NRP_MODEL_MAX_CONCURRENCY=16

# Our own stricter subagent limit. 5 x 64K = 320K, which is the binding constraint
# under rule 3, so this cannot rise unless subagent context shrinks or the budget
# above does.
KIMI_SUBAGENT_CONCURRENCY=5

# Kimi background-task slots. Keep this above KIMI_SUBAGENT_CONCURRENCY so a
# backgrounded build does not cost a subagent a lane; the proxy paces the upstream.
KIMI_BACKGROUND_TASK_SLOTS=8

# Background Bash wall clock in seconds; 0 means no timeout. Subagent and swarm
# wall clocks are NOT set here: they live in runtime/config.toml as
# [subagent]/[swarm] timeout_ms, because the KIMI_*_TIMEOUT_MS variables accept
# only a positive integer and would outrank that file.
KIMI_BACKGROUND_BASH_TASK_TIMEOUT_S=0

# A stalled upstream read releases its fair-use permit instead of wedging the lane.
NRP_UPSTREAM_SOCK_READ_TIMEOUT=300

# Hard ceiling on how long the proxy keeps retrying one client request.
NRP_MAX_REQUEST_SECONDS=3600

# Coarse per-lane input ceiling (percent of the lane input cap) that catches policy
# drift or abuse without false-rejecting image and video payloads.
NRP_INPUT_GUARD_PERCENT=150
NRP_MEDIA_TOKEN_ESTIMATE=1600

# Bounded proxy ingress. Increase only after reviewing host memory use.
NRP_MAX_REQUEST_BYTES=268435456
NRP_MAX_RESPONSE_BYTES=536870912
NRP_MAX_ERROR_BYTES=65536
NRP_MAX_QUEUED=32
NRP_PRIMARY_MAX_OUTPUT_TOKENS=65536
NRP_LONG_MAX_OUTPUT_TOKENS=65536
NRP_SUBAGENT_MAX_OUTPUT_TOKENS=8192


# ------------------------------------------------------------
# Optional GitHub MCP
# ------------------------------------------------------------

# Use a dedicated, minimal, read-only token.
# Leave blank until GitHub MCP is enabled.
GITHUB_PERSONAL_ACCESS_TOKEN=


# ------------------------------------------------------------
# Optional release API authentication
# ------------------------------------------------------------

# Public GitHub release metadata works without a token, subject to the
# unauthenticated API rate limit. Use a dedicated read-only token only if needed.
GITHUB_RELEASES_TOKEN=

# Optional remote MCP bearer credentials; public access can work without them.
# Neither variable enables a disabled MCP server. See docs/verification.md.
CONTEXT7_API_KEY=


# ------------------------------------------------------------
# Local SearXNG
# ------------------------------------------------------------

# Generate with: openssl rand -hex 32
# Local SearXNG signing secret, not a third-party API token.
SEARXNG_SECRET=

# Bounded search normalization.
SEARCH_MAX_RESPONSE_BYTES=4194304
SEARCH_MAX_RESULTS=20
SEARCH_MAX_REQUEST_BYTES=65536
SEARCH_MAX_FIELD_CHARS=16384
SEARCH_MAX_OUTPUT_BYTES=1048576
SEARCH_CONNECT_TIMEOUT=10
SEARCH_READ_TIMEOUT=20

# Capacity warnings never block startup.
KIMI_WARN_FREE_DISK_GIB=20
KIMI_WARN_TOTAL_MEMORY_GIB=8
