services:
  model-proxy:
    mem_limit: 1g
    cpus: 2
    pids_limit: 512
    logging: &bounded-logs
      driver: json-file
      options:
        max-size: 20m
        max-file: "3"
  kimi-agent:
    mem_limit: 16g
    cpus: 8
    logging: *bounded-logs
  search-adapter:
    mem_limit: 512m
    cpus: 2
    pids_limit: 256
    logging: *bounded-logs
  searxng:
    mem_limit: 2g
    cpus: 4
    pids_limit: 512
    logging: *bounded-logs
  comfyui:
    mem_limit: 32g
    cpus: 12
    logging: *bounded-logs
