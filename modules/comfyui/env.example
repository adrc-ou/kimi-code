# Optional values to copy into the harness .env; this file is not loaded.
# Optional absolute external storage roots. Leave blank to use WORKSPACE_PATH.
COMFYUI_MODELS_PATH=
COMFYUI_CUSTOM_NODES_PATH=
COMFYUI_INPUT_PATH=
COMFYUI_OUTPUT_PATH=
COMFYUI_TEMP_PATH=
COMFYUI_USER_PATH=


# ComfyUI client/transfer timing.
COMFYUI_CONNECT_TIMEOUT=10
COMFYUI_READ_TIMEOUT=60
COMFYUI_TOTAL_TIMEOUT=1800
COMFYUI_MAX_JSON_BYTES=16777216
COMFYUI_MAX_TRANSFER_BYTES=17179869184
COMFYUI_BRIDGE_MAX_BODY=536870912
COMFYUI_BRIDGE_MAX_WS_MESSAGE=67108864
COMFYUI_BRIDGE_MAX_CONNECTIONS=16

# Browser access to the frontend. The bridge keeps demanding its bearer token on
# every path; a browser instead redeems one single-use grant for a short-lived
# HttpOnly cookie. Grant lifetime in seconds, session lifetime in seconds
# (43200 is twelve hours), and how many sessions may be open at once.
COMFYUI_BRIDGE_GRANT_TTL=60
COMFYUI_BRIDGE_SESSION_TTL=43200
COMFYUI_BRIDGE_MAX_SESSIONS=8

# Set to false to stop the module opening ComfyUI in the host's default browser
# once its bridge is ready. ComfyUI still serves the frontend either way.
COMFYUI_OPEN_FRONTEND=true


COMFYUI_MACOS_PYTHON=
HF_TOKEN=
